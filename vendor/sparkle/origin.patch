+// Set only from the application's explicit feed override, never appcast contents.
+static NSString *SUDownloadOriginHeader = @"X-Solstone-Update-Origin";
+
+static BOOL SUIsApprovedDownloadURL(NSURL *url, NSURL *origin)
+{
+    return url != nil && origin != nil
+        && [url.scheme.lowercaseString isEqualToString:@"https"]
+        && [origin.scheme.lowercaseString isEqualToString:@"https"]
+        && url.host.length > 0 && origin.host.length > 0
+        && [url.host.lowercaseString isEqualToString:origin.host.lowercaseString]
+        && (url.port == nil ? 443 : url.port.integerValue) == (origin.port == nil ? 443 : origin.port.integerValue)
+        && url.user == nil && url.password == nil
+        && origin.user == nil && origin.password == nil;
+}
+
+static NSError *SUDownloadOriginError(void)
+{
+    return [NSError errorWithDomain:SUSparkleErrorDomain code:SUDownloadError
+        userInfo:@{NSLocalizedDescriptionKey: @"the update download was blocked because its address is not allowed."}];
+}
+
