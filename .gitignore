# Snapshot renders (negate trailing-slash so the un-ignore below can take effect)
snapshots/*
# Brand-alignment validation reports are documentation, not test artifacts — keep tracked.
!snapshots/brand-alignment-validation-*.md

# Local scratch / debug logs
scratch/
.hop/

# Distribution build artifacts
*.dmg

# AppIcon.iconset is an intermediate artifact built by `make icons`
# in a temp dir. The shipping artifact is AppIcon.icns. Use
# `iconutil -c iconset Sources/solstone/Resources/AppIcon.icns` to
# extract sized PNGs on demand.
Sources/solstone/Resources/AppIcon.iconset/
