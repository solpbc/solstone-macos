<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>solstone</string>
    <key>CFBundleDisplayName</key>
    <string>solstone</string>
    <key>CFBundleIdentifier</key>
    <string>app.solstone.observer</string>
    <key>CFBundleVersion</key>
    <string>1.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>solstone</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>solstone continuously captures your screen to build your personal memory. your captures stay on your mac and are sent only to your configured server — nothing else.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>solstone captures conversations and meetings to make them searchable. audio is stored on your device and goes only to your server.</string>
    <key>NSSystemAudioRecordingUsageDescription</key>
    <string>solstone captures system audio from calls and media to include in your memory. this requires system audio permission.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>solstone uses on-device speech recognition to identify audio containing conversation, so only meaningful audio is kept.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>solstone connects to your local observer server to upload captures.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_http._tcp</string>
        <string>_https._tcp</string>
    </array>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 sol pbc. all rights reserved.</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
</dict>
</plist>
